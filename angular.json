              "src/assets/js/transliteration.I.js",
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/slick-carousel/slick/slick.min.js",
              "src/assets/js/skdslider.min.js",

              "node_modules/datatables.net/js/jquery.dataTables.js",
              
